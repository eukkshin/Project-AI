# DINOVO local FastAPI (never commit real secrets)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
KAKAO_REST_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://heartbreakkid.co.kr
DATABASE_URL=sqlite:///./dinovo.sqlite3

# Web Push VAPID (PEM or supported private key string; use literal newlines in Render)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Provider OAuth (all optional, disabled until both ID and secret + PUBLIC_API_ORIGIN are set)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple deferred

# Configure registered provider callback exactly:
# <PUBLIC_API_ORIGIN>/api/auth/oauth/<provider>/callback
# For local OAuth tests, provider must allow localhost redirect and frontend URL.
PUBLIC_API_ORIGIN=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Actual external bookings/payment remain disabled in backend code (hard 403).
